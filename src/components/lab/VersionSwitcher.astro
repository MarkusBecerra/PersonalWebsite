---
import { showVersionSwitcher, siteVersions } from '@/lab/versions'

interface Props {
	/** Id of the version this page belongs to. */
	current: string
}

const { current } = Astro.props
const show = showVersionSwitcher()
const active = siteVersions.find((v) => v.id === current)
---

{
	show && (
		<details class='version-switcher' data-version-switcher>
			<summary aria-label={`Site version: ${active?.name ?? current}. Switch version`}>
				<span class='vs-dot' aria-hidden='true' />
				<span class='vs-kicker'>Version</span>
				<span class='vs-name'>{active?.name ?? current}</span>
				<svg viewBox='0 0 12 12' aria-hidden='true' class='vs-caret'>
					<path d='M3 7.5 6 4.5l3 3' fill='none' stroke='currentColor' stroke-width='1.4' />
				</svg>
			</summary>
			<ul role='list'>
				{siteVersions.map((v) => (
					<li>
						{v.href ? (
							<a
								href={v.href}
								aria-current={v.id === current ? 'page' : undefined}
								data-astro-prefetch='false'
							>
								<span class='vs-item-name'>{v.name}</span>
								<span class='vs-item-blurb'>{v.blurb}</span>
							</a>
						) : (
							<span class='vs-soon' aria-disabled='true'>
								<span class='vs-item-name'>
									{v.name} <em>idea</em>
								</span>
								<span class='vs-item-blurb'>{v.blurb}</span>
							</span>
						)}
					</li>
				))}
				<li class='vs-note'>Only you see this while the site is locked.</li>
			</ul>
		</details>
	)
}

<script>
	// Close on Escape or on a click anywhere else, like a real menu.
	const el = document.querySelector<HTMLDetailsElement>('[data-version-switcher]')
	if (el) {
		document.addEventListener('click', (e) => {
			if (el.open && !el.contains(e.target as Node)) el.open = false
		})
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && el.open) {
				el.open = false
				el.querySelector('summary')?.focus()
			}
		})
	}
</script>

<style>
	/*
	 * Deliberately theme-neutral (smoked glass) so it reads the same on the paper
	 * site and on every experimental version.
	 */
	.version-switcher {
		position: fixed;
		right: max(1rem, env(safe-area-inset-right));
		bottom: max(1rem, env(safe-area-inset-bottom));
		z-index: 60;
		font-family: Satoshi, ui-sans-serif, system-ui, sans-serif;
		font-size: 0.8125rem;
		line-height: 1.3;
		color: #f4f1ea;
	}
	summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		cursor: pointer;
		padding: 0.55rem 0.85rem;
		border-radius: 999px;
		background: rgb(20 18 16 / 0.78);
		border: 1px solid rgb(255 255 255 / 0.14);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 6px 24px -8px rgb(0 0 0 / 0.5);
		user-select: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: 2px solid #9fd1b3;
		outline-offset: 2px;
	}
	.vs-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: #9fd1b3;
		box-shadow: 0 0 8px #9fd1b3;
	}
	.vs-kicker {
		opacity: 0.6;
	}
	.vs-name {
		font-weight: 600;
	}
	.vs-caret {
		width: 0.75rem;
		height: 0.75rem;
		opacity: 0.7;
		transition: transform 0.2s;
	}
	.version-switcher[open] .vs-caret {
		transform: rotate(180deg);
	}
	ul {
		position: absolute;
		right: 0;
		bottom: calc(100% + 0.5rem);
		width: min(17rem, calc(100vw - 2rem));
		margin: 0;
		padding: 0.35rem;
		border-radius: 0.9rem;
		background: rgb(20 18 16 / 0.92);
		border: 1px solid rgb(255 255 255 / 0.14);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		box-shadow: 0 18px 48px -12px rgb(0 0 0 / 0.6);
		list-style: none;
	}
	li a,
	.vs-soon {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.55rem 0.7rem;
		border-radius: 0.6rem;
		color: inherit;
		text-decoration: none;
	}
	li a:hover,
	li a:focus-visible {
		background: rgb(255 255 255 / 0.08);
		outline: none;
	}
	li a[aria-current='page'] {
		background: rgb(159 209 179 / 0.16);
	}
	li a[aria-current='page'] .vs-item-name::after {
		content: ' ●';
		color: #9fd1b3;
		font-size: 0.6rem;
		vertical-align: middle;
	}
	.vs-soon {
		opacity: 0.45;
		cursor: default;
	}
	.vs-item-name {
		font-weight: 600;
	}
	.vs-item-name em {
		font-style: normal;
		font-weight: 400;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-left: 0.25rem;
		opacity: 0.8;
	}
	.vs-item-blurb {
		opacity: 0.65;
	}
	.vs-note {
		padding: 0.5rem 0.7rem 0.35rem;
		border-top: 1px solid rgb(255 255 255 / 0.08);
		margin-top: 0.25rem;
		font-size: 0.72rem;
		opacity: 0.5;
	}
</style>
