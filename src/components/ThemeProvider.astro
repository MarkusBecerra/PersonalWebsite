<script is:inline>
	const lightModePref = window.matchMedia('(prefers-color-scheme: light)')

	// An explicit choice (made with the header toggle) wins; otherwise follow the OS.
	function getUserPref() {
		const storedTheme = localStorage.getItem('theme') ?? undefined
		return storedTheme || (lightModePref.matches ? 'light' : 'dark')
	}

	// `.dark` drives Tailwind; `data-theme` drives the expressive-code blocks, which
	// otherwise only follow the OS setting and ignore the toggle.
	function applyTheme(theme) {
		if (theme !== 'light' && theme !== 'dark') {
			return console.log(`Invalid theme value '${theme}' received. Expected 'light' or 'dark'.`)
		}

		const root = document.documentElement
		root.classList.toggle('dark', theme === 'dark')
		root.dataset.theme = theme
	}

	// Initial Setup
	applyTheme(getUserPref())

	// View Transitions hook to restore theme
	document.addEventListener('astro:after-swap', () => applyTheme(getUserPref()))

	// Listen for theme-change custom event (the header toggle)
	document.addEventListener('theme-change', (e) => {
		localStorage.setItem('theme', e.detail.theme)
		applyTheme(e.detail.theme)
	})

	// Changing the OS setting is a fresh signal: follow it and drop the stored choice.
	lightModePref.addEventListener('change', (e) => {
		localStorage.removeItem('theme')
		applyTheme(e.matches ? 'light' : 'dark')
	})
</script>
