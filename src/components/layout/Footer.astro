---
import { siteConfig } from '@/site-config'

const year = new Date().getFullYear()

const socials = [
	{
		label: 'GitHub',
		href: 'https://github.com/markusbecerra',
		path: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504c.5.092.682-.217.682-.483c0-.237-.008-.868-.013-1.703c-2.782.605-3.369-1.343-3.369-1.343c-.454-1.158-1.11-1.466-1.11-1.466c-.908-.62.069-.608.069-.608c1.003.07 1.531 1.032 1.531 1.032c.892 1.53 2.341 1.088 2.91.832c.092-.647.35-1.088.636-1.338c-2.22-.253-4.555-1.113-4.555-4.951c0-1.093.39-1.988 1.029-2.688c-.103-.253-.446-1.272.098-2.65c0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027c.546 1.379.202 2.398.1 2.651c.64.7 1.028 1.595 1.028 2.688c0 3.848-2.339 4.695-4.566 4.943c.359.309.678.92.678 1.855c0 1.338-.012 2.419-.012 2.747c0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2z'
	},
	{
		label: 'SoundCloud',
		href: 'https://soundcloud.com/',
		path: 'M11.5 12.5v6h7.7a3.3 3.3 0 0 0 .3-6.59A4.5 4.5 0 0 0 11.5 11zm-1 6V13a2.5 2.5 0 0 0 0 5zm-2-4.8v4.8c-.3 0-.6-.05-.9-.14V13.6c.3-.2.6-.32.9-.4zm-2 1.1v3.5a2 2 0 0 1 0-3.5z'
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/',
		path: 'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8.34 17.34V10.5H6.16v6.84zM7.25 9.31a1.26 1.26 0 1 0 0-2.52a1.26 1.26 0 0 0 0 2.52m10.09 8.03v-3.74c0-2-.43-3.54-2.77-3.54a2.43 2.43 0 0 0-2.19 1.2h-.03V10.5h-2.1v6.84h2.18v-3.39c0-.89.17-1.76 1.28-1.76c1.09 0 1.1 1.02 1.1 1.82v3.33z'
	}
]
---

<footer class='mt-24 border-t border-border pt-8'>
	<div class='flex flex-col items-center gap-y-4 sm:flex-row sm:justify-between sm:gap-y-0'>
		<p class='text-sm text-muted-foreground'>
			© {year} {siteConfig.author}. Made at golden hour.
		</p>

		<div class='flex items-center gap-x-2'>
			{
				socials.map((s) => (
					<a
						href={s.href}
						target='_blank'
						rel='noopener noreferrer'
						aria-label={s.label}
						class='flex h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground'
					>
						<svg class='h-[1.1rem] w-[1.1rem]' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>
							<path fill='currentColor' d={s.path} />
						</svg>
					</a>
				))
			}
		</div>
	</div>
</footer>
