---
import { siteConfig } from '@/site-config'

const year = new Date().getFullYear()

const socials = [
	{
		label: 'GitHub',
		href: 'https://github.com/markusbecerra'
	},
	{
		label: 'SoundCloud',
		href: 'https://soundcloud.com/'
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/'
	}
]
---

<footer
	class='mt-24 flex flex-col gap-y-3 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between'
>
	<p>© {year} {siteConfig.author}</p>

	<ul class='flex items-center gap-x-5'>
		{
			socials.map((s) => (
				<li>
					<a
						href={s.href}
						target='_blank'
						rel='noopener noreferrer'
						class='transition-colors hover:text-foreground'
					>
						{s.label}
					</a>
				</li>
			))
		}
	</ul>
</footer>
