---
import { siteConfig, menuLinks } from '@/site-config'

const pathname = Astro.url.pathname
const isActive = (path: string) =>
	path === '/' ? pathname === '/' : pathname.startsWith(path.replace(/\/$/, ''))
---

<header class='mb-12 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 sm:mb-20'>
	<a class='py-2 font-display text-xl tracking-tight transition-colors hover:text-brand' href='/'>
		{siteConfig.author}
	</a>

	<!--
		Below sm the nav takes its own full-width row under the name, set off by a
		hairline like every other row on the site, with the links spread edge to edge.
	-->
	<nav
		class='flex w-full items-center justify-between gap-x-2 border-t border-border pt-1 text-[0.95rem] sm:w-auto sm:justify-start sm:gap-x-5 sm:border-0 sm:pt-0'
		aria-label='Primary'
	>
		{
			menuLinks.map((link) => (
				<a
					href={link.path}
					class:list={[
						// The underline is drawn, not text-decoration, so it can grow in from the left on hover.
						'nav-link relative px-1 py-2.5 transition-colors first:-ms-1',
						isActive(link.path)
							? 'text-foreground after:scale-x-100'
							: 'text-muted-foreground hover:text-foreground hover:after:scale-x-100'
					]}
					aria-current={isActive(link.path) ? 'page' : undefined}
				>
					{link.title}
				</a>
			))
		}

		<button
			id='toggleDarkMode'
			class='-me-2 flex h-10 w-10 items-center justify-center rounded-full text-muted-foreground transition-colors hover:text-foreground sm:-me-2.5'
			aria-label='Dark theme'
			aria-pressed='false'
		>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				viewBox='0 0 24 24'
				class='h-[1.1rem] w-[1.1rem] dark:hidden'
				><path
					fill='currentColor'
					d='M12 15q1.25 0 2.125-.875T15 12q0-1.25-.875-2.125T12 9q-1.25 0-2.125.875T9 12q0 1.25.875 2.125T12 15m0 1q-1.671 0-2.836-1.164T8 12q0-1.671 1.164-2.836T12 8q1.671 0 2.836 1.164T16 12q0 1.671-1.164 2.836T12 16m-7-3.5H1.5v-1H5zm17.5 0H19v-1h3.5zM11.5 5V1.5h1V5zm0 17.5V19h1v3.5zM6.746 7.404l-2.16-2.098l.695-.744l2.111 2.134zM18.72 19.438l-2.117-2.14l.652-.702l2.16 2.098zM16.596 6.746l2.098-2.16l.744.695l-2.134 2.111zM4.562 18.72l2.14-2.117l.663.652l-2.078 2.179zM12 12'
				></path></svg
			>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				viewBox='0 0 24 24'
				class='hidden h-[1.1rem] w-[1.1rem] dark:block'
				><path
					fill='currentColor'
					d='M12.058 20q-3.334 0-5.667-2.333Q4.058 15.333 4.058 12q0-3.038 1.98-5.27Q8.02 4.5 10.942 4.097q.081 0 .159.006t.153.017q-.506.706-.801 1.57q-.295.865-.295 1.811q0 2.667 1.866 4.533q1.867 1.867 4.534 1.867q.952 0 1.813-.295q.862-.295 1.548-.801q.012.075.018.153q.005.078.005.158q-.384 2.923-2.615 4.904T12.057 20'
				></path></svg
			>
		</button>
	</nav>
</header>

<script>
	const toggleDarkModeButton = document.getElementById('toggleDarkMode')
	const isDark = () => document.documentElement.classList.contains('dark')
	const syncPressed = () => toggleDarkModeButton?.setAttribute('aria-pressed', String(isDark()))

	syncPressed()
	new MutationObserver(syncPressed).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['class']
	})

	toggleDarkModeButton?.addEventListener('click', () => {
		const toggleDarkModeEvent = new CustomEvent('theme-change', {
			detail: { theme: isDark() ? 'light' : 'dark' }
		})
		document.dispatchEvent(toggleDarkModeEvent)
	})
</script>
