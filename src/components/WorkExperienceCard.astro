---
interface Props {
	employer: string
	title: string
	duration: string
	team: string
	skills: string[]
	location?: string
}

const { employer, title, duration, team, location, skills } = Astro.props
---

<article class='grid gap-y-1.5 py-6 sm:grid-cols-[9rem_1fr] sm:gap-x-6'>
	<p class='pt-1 text-sm tabular-nums text-muted-foreground'>{duration}</p>

	<div class='flex flex-col gap-y-1.5'>
		<h3 class='font-display text-xl leading-snug tracking-tight'>
			{title}
			<span class='italic text-muted-foreground'>at</span>
			{employer}
		</h3>
		<p class='text-sm text-muted-foreground'>
			{team}
			{location && <> · {location}</>}
		</p>
		{skills.length > 0 && <p class='mt-1 text-sm'>{skills.join(' · ')}</p>}
	</div>
</article>
