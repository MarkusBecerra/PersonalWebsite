---
interface Props {
	title: string
	description: string
	tags?: string[]
	links?: Array<{ label: string; href: string }>
	badge?: string
}

const { title, description, tags = [], links = [], badge } = Astro.props
---

<div class='flex flex-col gap-y-3 rounded-2xl border border-border bg-card p-5'>
	<div class='flex items-start justify-between gap-x-3'>
		<h3 class='font-display text-lg font-medium leading-snug tracking-tight'>{title}</h3>
		{
			badge && (
				<span class='shrink-0 rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground'>
					{badge}
				</span>
			)
		}
	</div>
	<p class='text-sm text-muted-foreground'>{description}</p>
	{
		tags.length > 0 && (
			<div class='flex flex-wrap gap-1.5'>
				{tags.map((tag) => (
					<span class='rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground'>
						{tag}
					</span>
				))}
			</div>
		)
	}
	{
		links.length > 0 && (
			<div class='flex flex-wrap gap-4 pt-1'>
				{links.map((link) => (
					<a
						href={link.href}
						target='_blank'
						rel='noopener noreferrer'
						class='inline-flex items-center gap-x-1 text-sm font-medium text-brand transition-opacity hover:opacity-75'
					>
						{link.label}
						<svg
							class='h-3.5 w-3.5'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'
							stroke-linejoin='round'
						>
							<path d='M7 17L17 7M7 7h10v10' />
						</svg>
					</a>
				))}
			</div>
		)
	}
	<slot />
</div>
