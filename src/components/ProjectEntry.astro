---
interface Props {
	title: string
	description: string
	tags?: string[]
	links?: Array<{ label: string; href: string }>
	badge?: string
}

const { title, description, tags = [], links = [], badge } = Astro.props
---

<article class='flex flex-col gap-y-1.5 py-5'>
	<div class='flex items-baseline justify-between gap-x-4'>
		<h3 class='font-display text-xl leading-snug tracking-tight'>{title}</h3>
		{badge && <span class='shrink-0 text-sm italic text-muted-foreground'>{badge}</span>}
	</div>
	<p class='text-muted-foreground'>{description}</p>
	{tags.length > 0 && <p class='text-sm'>{tags.join(' · ')}</p>}
	{
		links.length > 0 && (
			<p class='flex flex-wrap gap-x-5 pt-1 text-sm'>
				{links.map((link) => (
					<a href={link.href} target='_blank' rel='noopener noreferrer' class='link'>
						{link.label} ↗<span class='sr-only'> (opens in new tab)</span>
					</a>
				))}
			</p>
		)
	}
	<slot />
</article>
