---
import { CATEGORIES } from '@/content/config'

interface Props {
	category: string
	class?: string
}

const { category, class: className = '' } = Astro.props

// Typed against CATEGORIES — TypeScript will error if a category is missing here.
const styles: Record<(typeof CATEGORIES)[number], string> = {
	engineering: 'bg-violet-500/10 text-violet-700 dark:text-violet-300 ring-violet-500/20',
	music:       'bg-blue-500/10 text-blue-700 dark:text-blue-300 ring-blue-500/20',
	recreation:  'bg-teal-600/10 text-teal-700 dark:text-teal-300 ring-teal-600/20',
	general:     'bg-secondary text-muted-foreground ring-border'
}

const cls = styles[category as keyof typeof styles] ?? styles.general
---

<span
	class:list={[
		'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium capitalize ring-1 ring-inset',
		cls,
		className
	]}
>
	{category}
</span>
