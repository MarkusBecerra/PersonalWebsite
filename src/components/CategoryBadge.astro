---
import { CATEGORIES } from '@/content/config'

interface Props {
	category: string
	class?: string
}

const { category, class: className = '' } = Astro.props

// Typed against CATEGORIES — TypeScript will error if a category is missing here.
// Each category gets a small earth-toned dot rather than a colored pill.
const dots: Record<(typeof CATEGORIES)[number], string> = {
	engineering: 'bg-sky-800/70 dark:bg-sky-300/70',
	music: 'bg-orange-700/70 dark:bg-orange-300/70',
	recreation: 'bg-emerald-800/70 dark:bg-emerald-300/70',
	general: 'bg-muted-foreground/50'
}

const dot = dots[category as keyof typeof dots] ?? dots.general
---

<span
	class:list={['inline-flex items-center gap-x-1.5 capitalize text-muted-foreground', className]}
>
	<span class:list={['h-1.5 w-1.5 rounded-full', dot]} aria-hidden='true'></span>
	{category}
</span>
