---
// A small, warm pill that color-codes each post by its pillar.
interface Props {
	category: string
	class?: string
}

const { category, class: className = '' } = Astro.props

// Restrained, masculine spread: steel · gold · olive — all in a warm Dior key.
const styles: Record<string, string> = {
	engineering: 'bg-slate-500/10 text-slate-600 dark:text-slate-300 ring-slate-500/20',
	music: 'bg-amber-600/10 text-amber-700 dark:text-amber-300 ring-amber-600/25',
	recreation: 'bg-lime-700/10 text-lime-700 dark:text-lime-300/90 ring-lime-700/20',
	general: 'bg-secondary text-muted-foreground ring-border'
}

const cls = styles[category] ?? styles.general
---

<span
	class:list={[
		'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium capitalize ring-1 ring-inset',
		cls,
		className
	]}
>
	{category}
</span>
