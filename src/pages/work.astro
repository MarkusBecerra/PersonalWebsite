---
import PageLayout from '@/layouts/BaseLayout.astro'
import WorkExperienceCard from '@/components/WorkExperienceCard.astro'

// ─── Skills ───────────────────────────────────────────────────────────────────
// Replace / extend with your actual skills and honest levels.
// Levels: 'advanced' | 'intermediate' | 'beginner'
type Level = 'advanced' | 'intermediate' | 'beginner'

const skills: Array<{ name: string; level: Level }> = [
	{ name: '[Skill A]', level: 'advanced' },
	{ name: '[Skill B]', level: 'advanced' },
	{ name: '[Skill C]', level: 'intermediate' },
	{ name: '[Skill D]', level: 'intermediate' },
	{ name: '[Skill E]', level: 'beginner' }
]

const levels: Level[] = ['advanced', 'intermediate', 'beginner']
const skillsByLevel = levels
	.map((level) => ({ level, names: skills.filter((s) => s.level === level).map((s) => s.name) }))
	.filter((group) => group.names.length > 0)

// ─── Experience ───────────────────────────────────────────────────────────────
// Add one object per role. Duplicate the template block to add more entries.
// Fields:
//   employer  — company or organization name
//   title     — your job title / role
//   duration  — e.g. "Jun 2022 – Present" or "Jan 2020 – May 2022"
//   team      — team or department name
//   location  — city, state or "Remote" (optional)
//   skills    — list of tools / languages / frameworks you used in this role
const experiences = [
	{
		employer: '[Company Name]',
		title: '[Your Title]',
		duration: '[Start] – [End or Present]',
		team: '[Team / Department]',
		location: '[City, State or Remote]',
		skills: ['[Skill A]', '[Skill B]', '[Skill C]']
	}
	// Add more entries here ↑
]
---

<PageLayout
	meta={{ title: 'Work', description: 'Professional experience and skills of Markus Becerra.' }}
>
	<section class='flex flex-col gap-y-4'>
		<h1 class='font-display text-4xl tracking-tight sm:text-5xl'>Work</h1>
		<p class='max-w-xl text-lg text-muted-foreground'>
			The roles I've held and the skills I've built — paid, shipped, and production-grade.
		</p>
	</section>

	<!-- Experience ──────────────────────────────────────────────────────────── -->
	<section class='mt-16'>
		<h2 class='section-title'>Experience</h2>
		<div class='divide-y divide-border'>
			{experiences.map((exp) => <WorkExperienceCard {...exp} />)}
		</div>
	</section>

	<!-- Skills ──────────────────────────────────────────────────────────────── -->
	<section class='mt-16'>
		<h2 class='section-title'>Skills</h2>
		<dl class='divide-y divide-border'>
			{
				skillsByLevel.map(({ level, names }) => (
					<div class='grid gap-y-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-x-6'>
						<dt class='capitalize text-muted-foreground'>{level}</dt>
						<dd>{names.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</section>
</PageLayout>
