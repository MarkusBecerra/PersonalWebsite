---
import PageLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts, getUniqueTagsWithCount } from '@/utils'

const allPosts = await getAllPosts()
const allTags = getUniqueTagsWithCount(allPosts)

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: 'All Tags'
}
---

<PageLayout meta={meta}>
	<div class='w-full'>
		<a href='/blog' class='text-sm text-muted-foreground transition-colors hover:text-foreground'>
			← All writing
		</a>

		<h1 class='mb-8 mt-6 font-display text-4xl tracking-tight'>Tags</h1>
		{allTags.length === 0 && <p class='italic text-muted-foreground'>No posts yet.</p>}

		{
			allTags.length > 0 && (
				<ul class='divide-y divide-border border-t border-border'>
					{allTags.map(([tag, val]) => (
						<li class='flex items-baseline justify-between gap-x-4 py-3'>
							<a
								class='link'
								data-astro-prefetch
								href={`/tags/${tag}/`}
								title={`View posts with the tag: ${tag}`}
							>
								&#35;{tag}
							</a>
							<span class='text-sm tabular-nums text-muted-foreground'>
								{val} post{val > 1 && 's'}
							</span>
						</li>
					))}
				</ul>
			)
		}
	</div>
</PageLayout>
