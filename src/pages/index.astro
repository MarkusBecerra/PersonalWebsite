---
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/blog/PostPreview.astro'
import { getAllPosts, sortMDByDate } from '@/utils'

const MAX_POSTS = 5
const allPosts = await getAllPosts()
const latestPosts = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// The three pillars of the site. Edit copy / links freely.
const pillars = [
	{
		title: 'Engineering',
		blurb: 'Software I design and ship — systems, side projects, and notes from the build.',
		href: '/blog'
	},
	{
		title: 'Projects',
		blurb:
			"Music mixes, software side projects, and fitness milestones — a catalogue of everything I'm building.",
		href: '/projects'
	},
	{
		title: 'Recreation',
		blurb: 'Climbing, bouldering, and time outside — chasing the next problem and the light.',
		href: '/blog'
	}
]
---

<PageLayout meta={{ title: 'Home' }}>
	<!-- Intro -->
	<section class='flex flex-col gap-y-6'>
		<h1 class='font-display text-4xl leading-[1.12] tracking-tight sm:text-5xl'>
			Hi, I’m Markus. I build software, sound <span class='italic text-brand'>& scrambles.</span>
		</h1>

		<p class='max-w-xl text-lg text-muted-foreground'>
			Engineer by trade, DJ by night, climber by weekend. This is where I keep notes on what I’m
			building, mixing, and climbing.
		</p>

		<p class='flex flex-wrap gap-x-6 gap-y-2'>
			<a href='/blog' class='link'>Read the blog</a>
			<a href='mailto:markusbecerra@gmail.com' class='link'>Say hello</a>
		</p>
	</section>

	<!-- Three pillars -->
	<section class='mt-20'>
		<h2 class='section-title'>What I’m into</h2>
		<ul class='divide-y divide-border'>
			{
				pillars.map((p) => (
					<li>
						<a
							href={p.href}
							class='group grid gap-y-1 py-5 sm:grid-cols-[9rem_1fr_auto] sm:items-baseline sm:gap-x-6'
						>
							<h3 class='font-display text-xl tracking-tight transition-colors group-hover:text-brand'>
								{p.title}
							</h3>
							<p class='text-muted-foreground'>{p.blurb}</p>
							<span
								class='hidden text-muted-foreground transition-all group-hover:translate-x-0.5 group-hover:text-brand sm:block'
								aria-hidden='true'
							>
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<!-- Latest posts -->
	<section class='mt-20'>
		<h2 class='section-title'>Latest writing</h2>

		{
			latestPosts.length === 0 ? (
				<p class='py-5 italic text-muted-foreground'>No posts yet — the first one is brewing.</p>
			) : (
				<div class='divide-y divide-border'>
					{latestPosts.map((p) => (
						<PostPreview as='h3' post={p} withDesc />
					))}
				</div>
			)
		}

		<a href='/blog' class='link mt-4 inline-block text-sm text-muted-foreground'>All writing</a>
	</section>
</PageLayout>
