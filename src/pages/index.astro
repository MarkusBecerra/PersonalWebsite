---
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/blog/PostPreview.astro'
import { getAllPosts, sortMDByDate } from '@/utils'

const MAX_POSTS = 5
const allPosts = await getAllPosts()
const latestPosts = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// The three pillars of the site. Edit copy / links freely.
const pillars = [
	{
		title: 'Engineering',
		blurb: 'Software I design and ship — systems, side projects, and notes from the build.',
		href: '/blog',
		accent: 'from-slate-500/15 to-slate-500/0',
		icon: 'M8 9l3 3l-3 3m5 0h3M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z'
	},
	{
		title: 'Music',
		blurb: 'SoundCloud mixes and activity — plus a concert log in the works. Reposts, likes, and live sets.',
		href: '/music',
		accent: 'from-blue-500/15 to-blue-500/0',
		icon: 'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0a3 3 0 0 1 6 0Zm12-2a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z'
	},
	{
		title: 'Recreation',
		blurb: 'Climbing, bouldering, and time outside — chasing the next problem and the light.',
		href: '/blog',
		accent: 'from-slate-500/15 to-slate-500/0',
		icon: 'M3 20h18M5 20l5.5-9l3 4l2-3L21 20M7 7a2 2 0 1 0 0-4a2 2 0 0 0 0 4Z'
	}
]
---

<PageLayout meta={{ title: 'Home' }}>
	<!-- Hero -->
	<section class='flex flex-col gap-y-4 pb-4'>

		<h1 class='font-display text-5xl font-medium leading-[1.05] tracking-tight sm:text-6xl'>
			Hi, I’m Markus — I build<br class='hidden sm:block' />
			<span class='text-sunset'>software, sound & scrambles.</span>
		</h1>

		<p class='max-w-xl text-lg text-muted-foreground'>
			Engineer by trade, DJ by night, climber by weekend. This is where I keep notes on what
			I’m building, mixing, and climbing — written in the spirit of golden hour.
		</p>

		<div class='flex flex-wrap items-center gap-3 pt-1'>
			<a
				href='/blog'
				class='inline-flex items-center gap-x-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90'
			>
				Read the blog
				<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24'>
					<path fill='currentColor' d='M5 12h13m0 0l-5-5m5 5l-5 5' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' fill-opacity='0'/>
				</svg>
			</a>
			<a
				href='mailto:markusbecerra@gmail.com'
				class='inline-flex items-center rounded-full border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:bg-secondary'
			>
				Get in touch
			</a>
		</div>
	</section>

	<!-- Three pillars -->
	<section class='mt-16'>
		<h2 class='mb-5 text-sm font-medium uppercase tracking-widest text-muted-foreground'>
			What I’m into
		</h2>
		<div class='grid gap-4 sm:grid-cols-3'>
			{
				pillars.map((p) => (
					<a
						href={p.href}
						class='group relative flex flex-col gap-y-3 overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-soft transition-all hover:-translate-y-1 hover:border-brand/40'
					>
						<div class:list={['pointer-events-none absolute inset-0 bg-gradient-to-br opacity-0 transition-opacity duration-300 group-hover:opacity-100', p.accent]} />
						<span class='relative flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-background text-brand'>
							<svg class='h-5 w-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
								<path d={p.icon} />
							</svg>
						</span>
						<h3 class='relative font-display text-xl font-medium tracking-tight'>{p.title}</h3>
						<p class='relative text-sm text-muted-foreground'>{p.blurb}</p>
						<span class='relative mt-1 inline-flex items-center gap-x-1 text-sm font-medium text-brand'>
							Explore
							<svg class='h-4 w-4 transition-transform group-hover:translate-x-0.5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
								<path d='M5 12h14m0 0l-6-6m6 6l-6 6' />
							</svg>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- Latest posts -->
	<section class='mt-16'>
		<div class='mb-3 flex items-baseline justify-between'>
			<h2 class='text-sm font-medium uppercase tracking-widest text-muted-foreground'>
				Latest posts
			</h2>
			<a href='/blog' class='text-sm text-muted-foreground transition-colors hover:text-foreground'>
				View all →
			</a>
		</div>

		{
			latestPosts.length === 0 ? (
				<p class='rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground'>
					No posts yet — the first one is brewing.
				</p>
			) : (
				<div class='flex flex-col divide-y divide-border'>
					{latestPosts.map((p) => (
						<PostPreview as='h3' post={p} withDesc />
					))}
				</div>
			)
		}
	</section>
</PageLayout>
