---
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/blog/PostPreview.astro'
import { getAllPosts, sortMDByDate } from '@/utils'

const MAX_POSTS = 5
const allPosts = await getAllPosts()
const latestPosts = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// The three pillars of the site. Edit copy / links freely.
const pillars = [
	{
		title: 'Engineering',
		blurb: 'Software I design and ship — systems, side projects, and notes from the build.',
		href: '/blog'
	},
	{
		title: 'Projects',
		blurb:
			"Music mixes, software side projects, and fitness milestones — a catalogue of everything I'm building.",
		href: '/projects'
	},
	{
		title: 'Recreation',
		blurb: 'Climbing, bouldering, and time outside — chasing the next problem and the light.',
		href: '/blog'
	}
]

// What I'm in the middle of, one row per hat. Rewrite these as they change;
// `href` is optional. Keep it to three or four rows.
const currently: Array<{ verb: string; what: string; href?: string }> = [
	{ verb: 'Building', what: 'this site, in Astro and Tailwind', href: '/blog/building-this-site/' },
	{
		verb: 'Mixing',
		what: 'a golden-hour house set for the rooftop',
		href: '/blog/sunset-set-notes/'
	},
	{
		verb: 'Projecting',
		what: 'a V5 slab that keeps sending me home',
		href: '/blog/project-of-the-week/'
	}
]
---

<PageLayout meta={{ title: 'Home' }}>
	<!-- Intro -->
	<section class='flex flex-col gap-y-6'>
		<h1 class='text-balance font-display text-4xl leading-[1.12] tracking-tight sm:text-5xl'>
			Hi, I’m Markus. I build software, sound <span class='whitespace-nowrap italic text-brand'
				>& scrambles.</span
			>
		</h1>

		<p class='max-w-xl text-lg text-muted-foreground'>
			Engineer by trade, DJ by night, climber by weekend. This is where I keep notes on what I’m
			building, mixing, and climbing.
		</p>

		<!-- Currently: a small field log in the same left-column idiom as the dates below -->
		<dl class='mt-4 divide-y divide-border border-y border-border' aria-label='Currently'>
			{
				currently.map((row) => (
					<div class='grid grid-cols-[6.5rem_1fr] items-baseline gap-x-4 py-2.5 sm:grid-cols-[9rem_1fr] sm:gap-x-6'>
						<dt class='font-display text-lg italic leading-snug text-muted-foreground'>
							{row.verb}
						</dt>
						<dd>
							{row.href ? (
								<a href={row.href} class='link'>
									{row.what}
								</a>
							) : (
								row.what
							)}
						</dd>
					</div>
				))
			}
		</dl>

		<p class='mt-2 flex flex-wrap gap-x-6 gap-y-2'>
			<a href='/blog' class='link'>Read the blog</a>
			<a href='mailto:markusbecerra@gmail.com' class='link'>Say hello</a>
		</p>
	</section>

	<!-- Three pillars -->
	<section class='mt-20 sm:mt-28'>
		<h2 class='section-title'>What I’m into</h2>
		<ul class='divide-y divide-border'>
			{
				pillars.map((p) => (
					<li>
						<a
							href={p.href}
							class='group grid gap-y-1 py-5 sm:grid-cols-[9rem_1fr_auto] sm:items-baseline sm:gap-x-6'
						>
							<h3 class='font-display text-xl tracking-tight transition-colors group-hover:text-brand'>
								{p.title}
							</h3>
							<p class='text-muted-foreground'>{p.blurb}</p>
							<span
								class='hidden text-muted-foreground transition-all group-hover:translate-x-0.5 group-hover:text-brand sm:block'
								aria-hidden='true'
							>
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<!-- Latest posts -->
	<section class='mt-14 sm:mt-16'>
		<h2 class='section-title'>Latest writing</h2>

		{
			latestPosts.length === 0 ? (
				<p class='py-5 italic text-muted-foreground'>No posts yet — the first one is brewing.</p>
			) : (
				<div class='divide-y divide-border'>
					{latestPosts.map((p) => (
						<PostPreview as='h3' post={p} withDesc />
					))}
				</div>
			)
		}

		<a href='/blog' class='link mt-4 inline-block text-sm'>All writing</a>
	</section>
</PageLayout>
