---
import '../styles/app.css'

import ThemeProvider from '@/components/ThemeProvider.astro'
import { siteConfig } from '@/site-config'
import {
	UNLOCK_COOKIE,
	UNLOCK_ENDPOINT,
	isSiteLocked,
	isUnlocked,
	safeRedirectPath
} from '@/site-lock'

export const prerender = false

const next = safeRedirectPath(Astro.url.searchParams.get('next'))

// Nothing to gate once the site is public, and no reason to ask twice.
if (!isSiteLocked()) return Astro.redirect('/', 302)
if (await isUnlocked(Astro.cookies.get(UNLOCK_COOKIE)?.value)) return Astro.redirect(next, 302)

const failed = Astro.url.searchParams.get('error') === '1'

// First name only — the page is meant to read like a note, not a masthead.
const firstName = siteConfig.author.split(' ')[0]
---

<html lang={siteConfig.lang}>
	<head>
		<meta charset='utf-8' />
		<meta content='width=device-width, initial-scale=1.0' name='viewport' />
		<title>Under construction {'•'} {siteConfig.title}</title>
		<meta content='noindex, nofollow' name='robots' />
		<meta content='#f8f5ef' media='(prefers-color-scheme: light)' name='theme-color' />
		<meta content='#191715' media='(prefers-color-scheme: dark)' name='theme-color' />
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			rel='stylesheet'
			href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap'
		/>
	</head>

	<body class='bg-background'>
		<ThemeProvider />

		<main class='mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-6 py-16'>
			<div>
				<h1 class='font-display text-4xl leading-tight tracking-tight'>Under construction</h1>

				<p class='mt-3 leading-relaxed text-muted-foreground'>
					{firstName} is still building this one. If you have the password, come on in — otherwise check
					back soon.
				</p>

				<form class='mt-7 flex flex-col gap-y-3' method='post' action={UNLOCK_ENDPOINT}>
					<input type='hidden' name='next' value={next} />

					<label class='sr-only' for='password'>Site password</label>
					<input
						class='w-full rounded-md border border-input bg-card px-4 py-2.5 text-sm placeholder:text-muted-foreground'
						id='password'
						name='password'
						type='password'
						autocomplete='current-password'
						placeholder='Password'
						required
						autofocus
						aria-describedby={failed ? 'unlock-error' : undefined}
						aria-invalid={failed ? 'true' : undefined}
					/>

					{
						failed && (
							<p class='text-sm text-destructive' id='unlock-error' role='alert'>
								That password didn{'’'}t work. Try again.
							</p>
						)
					}

					<button
						class='mt-1 w-full rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90'
						type='submit'
					>
						Let me in
					</button>
				</form>
			</div>

			<p class='mt-10 text-xs text-muted-foreground'>
				{siteConfig.title}
				{'—'} coming soon
			</p>
		</main>
	</body>
</html>
