---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
	description: 'Page not found',
	title: '404'
}
---

<PageLayout meta={meta}>
	<div class='flex flex-col items-center px-4 py-20 text-center'>
		<span class='font-display text-8xl font-medium text-sunset sm:text-9xl'>404</span>
		<p class='mt-4 text-lg text-muted-foreground'>This page slipped past golden hour.</p>
		<a
			href='/'
			class='mt-8 inline-flex items-center gap-x-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90'
		>
			<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24'>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'></path>
			</svg>
			Back home
		</a>
	</div>
</PageLayout>
