---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
	description: 'Page not found',
	title: '404'
}
---

<PageLayout meta={meta}>
	<div class='flex flex-col gap-y-4 py-12'>
		<p class='font-display text-lg italic text-muted-foreground'>404</p>
		<h1 class='font-display text-4xl tracking-tight sm:text-5xl'>Off the trail.</h1>
		<p class='text-lg text-muted-foreground'>This page doesn’t exist, or it wandered off.</p>
		<a href='/' class='link mt-2 w-fit'>Head back home</a>
	</div>
</PageLayout>
