---
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectEntry from '@/components/ProjectEntry.astro'

const meta = {
	title: 'Projects',
	description:
		"Music mixes, software side projects, fitness milestones — everything I'm building outside work."
}

// ─── MUSIC ────────────────────────────────────────────────────────────────────
// To add a mix: open the track/set on SoundCloud → Share → Embed → copy the
// `src` URL from the iframe and paste it below.
const mixes: Array<{ title: string; embedUrl: string }> = [
	// {
	//   title: 'Rooftop Sunset Set — May 2026',
	//   embedUrl: 'https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/your-handle/your-set&color=%23db9b3b&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=true'
	// }
]

const soundcloudProfile = 'https://soundcloud.com/' // ← replace with your handle

const musicRoadmap = [
	{
		title: 'Concert rating system',
		detail:
			'Log every show — artist, venue, date — with a personal rating and a short review. Sortable by score, recency, and genre.',
		status: 'Next up'
	},
	{
		title: 'Albums & tracks',
		detail:
			'Extend the same rating model to albums and standout tracks, so the whole listening history lives in one place.',
		status: 'Planned'
	},
	{
		title: 'Live SoundCloud activity',
		detail: 'Auto-pull recent reposts, likes, and uploads instead of hand-curating embeds.',
		status: 'Exploring'
	}
]

// ─── SOFTWARE ─────────────────────────────────────────────────────────────────
// Add software / side projects here. Each entry takes:
//   title       — project name
//   description — 1–2 sentence summary
//   tags        — tech stack or keywords (optional)
//   links       — array of { label, href } for GitHub, live demo, etc. (optional)
//   badge       — short status label, e.g. 'Active', 'Shipped', 'WIP' (optional)
const softwareProjects: Array<{
	title: string
	description: string
	tags?: string[]
	links?: Array<{ label: string; href: string }>
	badge?: string
}> = [
	// {
	//   title: 'Personal Website',
	//   description: 'This site — built with Astro 5, Tailwind CSS, and deployed on Vercel.',
	//   tags: ['Astro', 'TypeScript', 'Tailwind'],
	//   links: [{ label: 'GitHub', href: 'https://github.com/your-handle/personal-website' }],
	//   badge: 'Active'
	// }
]

// ─── FITNESS ──────────────────────────────────────────────────────────────────
// Log fitness milestones, climbing sends, race results — anything worth tracking.
// Use `badge` for the activity type (e.g. 'Bouldering', 'Running', 'Weightlifting').
const fitnessProjects: Array<{
	title: string
	description: string
	tags?: string[]
	links?: Array<{ label: string; href: string }>
	badge?: string
}> = [
	// {
	//   title: 'V6 Flash — Movement Oakland',
	//   description: 'Flashed my first V6 bouldering problem. Comp-style set with a big dynamic move to the lip.',
	//   tags: ['Bouldering', 'V6', 'Flash'],
	//   badge: 'Climbing'
	// }
]
---

<PageLayout meta={meta}>
	<section class='flex flex-col gap-y-4'>
		<h1 class='font-display text-4xl tracking-tight sm:text-5xl'>
			Things I’m building, mixing & tracking.
		</h1>
		<p class='max-w-xl text-lg text-muted-foreground'>
			A running catalogue of what I’m working on outside of work — music, software, and fitness
			milestones.
		</p>
		<nav class='flex gap-x-5 text-sm text-muted-foreground' aria-label='Project sections'>
			<a href='#music' class='link'>Music</a>
			<a href='#software' class='link'>Software</a>
			<a href='#fitness' class='link'>Fitness</a>
		</nav>
	</section>

	<!-- ─── Music ─────────────────────────────────────────────────────────────── -->
	<section id='music' class='mt-16 scroll-mt-8'>
		<h2 class='section-title'>Music</h2>
		<p class='mt-4 text-muted-foreground'>
			Mostly SoundCloud — the mixes I make, the sets I play, and what I’m reposting and loving. A
			proper concert log is on the way.{' '}
			<a
				href={soundcloudProfile}
				target='_blank'
				rel='noopener noreferrer'
				class='link text-foreground'
			>
				Follow on SoundCloud
				<span class='sr-only'> (opens in new tab)</span>
			</a>
		</p>

		{
			mixes.length === 0 ? (
				<p class='py-5 italic text-muted-foreground'>
					No mixes embedded yet. Paste a SoundCloud embed URL into the{' '}
					<code class='rounded-sm bg-secondary px-1 py-0.5 font-mono text-xs not-italic'>
						mixes
					</code>{' '}
					array in{' '}
					<code class='rounded-sm bg-secondary px-1 py-0.5 font-mono text-xs not-italic'>
						src/pages/projects.astro
					</code>
					.
				</p>
			) : (
				<div class='mt-6 flex flex-col gap-y-4'>
					{mixes.map((mix) => (
						<iframe
							title={mix.title}
							width='100%'
							height='166'
							class='block rounded-md border-0'
							allow='autoplay'
							loading='lazy'
							src={mix.embedUrl}
						/>
					))}
				</div>
			)
		}

		<h3 class='mt-8 font-display text-lg italic text-muted-foreground'>Coming up</h3>
		<ul class='mt-2 divide-y divide-border'>
			{
				musicRoadmap.map((item) => (
					<li class='grid gap-y-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-x-6'>
						<span class='pt-0.5 text-sm text-muted-foreground'>{item.status}</span>
						<div>
							<h4 class='font-medium'>{item.title}</h4>
							<p class='text-muted-foreground'>{item.detail}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<!-- ─── Software ──────────────────────────────────────────────────────────── -->
	<section id='software' class='mt-16 scroll-mt-8'>
		<h2 class='section-title'>Software</h2>
		<p class='mt-4 text-muted-foreground'>
			Side projects, tools, and things I’ve shipped outside of work.
		</p>
		{
			softwareProjects.length === 0 ? (
				<p class='py-5 italic text-muted-foreground'>
					No software projects listed yet. Add entries to the{' '}
					<code class='rounded-sm bg-secondary px-1 py-0.5 font-mono text-xs not-italic'>
						softwareProjects
					</code>{' '}
					array in
					<code class='rounded-sm bg-secondary px-1 py-0.5 font-mono text-xs not-italic'>
						src/pages/projects.astro
					</code>
					.
				</p>
			) : (
				<div class='mt-2 divide-y divide-border'>
					{softwareProjects.map((project) => (
						<ProjectEntry {...project} />
					))}
				</div>
			)
		}
	</section>

	<!-- ─── Fitness ───────────────────────────────────────────────────────────── -->
	<section id='fitness' class='mt-16 scroll-mt-8'>
		<h2 class='section-title'>Fitness</h2>
		<p class='mt-4 text-muted-foreground'>Climbing sends, PRs, and milestones worth logging.</p>
		{
			fitnessProjects.length === 0 ? (
				<p class='py-5 italic text-muted-foreground'>
					No fitness milestones logged yet. Add entries to the{' '}
					<code class='rounded-sm bg-secondary px-1 py-0.5 font-mono text-xs not-italic'>
						fitnessProjects
					</code>{' '}
					array in
					<code class='rounded-sm bg-secondary px-1 py-0.5 font-mono text-xs not-italic'>
						src/pages/projects.astro
					</code>
					.
				</p>
			) : (
				<div class='mt-2 divide-y divide-border'>
					{fitnessProjects.map((project) => (
						<ProjectEntry {...project} />
					))}
				</div>
			)
		}
	</section>
</PageLayout>
