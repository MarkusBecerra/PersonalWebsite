---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'

import PostLayout from '@/layouts/BlogPost.astro'
import { getAllPosts } from '@/utils'

// Used when the site is public and every post is prerendered. While the site is
// locked the build renders on demand instead, and Astro ignores this.
export const getStaticPaths = (async () => {
	const posts = await getAllPosts()
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}))
}) satisfies GetStaticPaths

type Props = Partial<InferGetStaticPropsType<typeof getStaticPaths>>

// Prerendered builds pass the post in as a prop; on-demand builds look it up.
// The lookup goes through getAllPosts so that drafts stay hidden in production —
// getEntry would happily serve one by its direct URL.
const post =
	Astro.props.post ?? (await getAllPosts()).find((entry) => entry.id === Astro.params.slug)
if (!post) return Astro.rewrite('/404')

const { Content } = await render(post)
---

<PostLayout post={post}>
	<Content />
</PostLayout>
