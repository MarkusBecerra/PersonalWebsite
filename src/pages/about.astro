---
import PageLayout from '@/layouts/BaseLayout.astro'

// ─── Hobbies ──────────────────────────────────────────────────────────────────
// Add, remove, or reorder freely — each entry renders as a pill tag.
const hobbies = [
	'Software Engineering',
	'DJing',
	'Music Production',
	'Bouldering',
	'Rock Climbing',
	'Hiking'
]

// ─── Socials ──────────────────────────────────────────────────────────────────
// Update each `href` and `handle` with your actual profile URLs.
// Set `deprecated: true` to dim the card and show a "Deprecated" badge.
const socials = [
	{
		label: 'X / Twitter',
		handle: '@markusbecerra',
		href: 'https://x.com/markusbecerra',
		deprecated: false,
		icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.732-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'
	},
	{
		label: 'Instagram',
		handle: '@markusbecerra',
		href: 'https://instagram.com/markusbecerra',
		deprecated: false,
		icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z'
	},
	{
		label: 'SoundCloud',
		handle: 'markusbecerra',
		href: 'https://soundcloud.com/markusbecerra',
		deprecated: false,
		icon: 'M11.5 12.5v6h7.7a3.3 3.3 0 0 0 .3-6.59A4.5 4.5 0 0 0 11.5 11zm-1 6V13a2.5 2.5 0 0 0 0 5zm-2-4.8v4.8c-.3 0-.6-.05-.9-.14V13.6c.3-.2.6-.32.9-.4zm-2 1.1v3.5a2 2 0 0 1 0-3.5z'
	},
	{
		label: 'Apple Music',
		handle: 'markusbecerra',
		href: 'https://music.apple.com/',
		deprecated: false,
		icon: 'M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z'
	},
	{
		label: 'Spotify',
		handle: 'markusbecerra',
		href: 'https://open.spotify.com/user/markusbecerra',
		deprecated: true,
		icon: 'M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z'
	},
	{
		label: 'LinkedIn',
		handle: 'Markus Becerra',
		href: 'https://linkedin.com/in/markusbecerra',
		deprecated: false,
		icon: 'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8.34 17.34V10.5H6.16v6.84zM7.25 9.31a1.26 1.26 0 1 0 0-2.52a1.26 1.26 0 0 0 0 2.52m10.09 8.03v-3.74c0-2-.43-3.54-2.77-3.54a2.43 2.43 0 0 0-2.19 1.2h-.03V10.5h-2.1v6.84h2.18v-3.39c0-.89.17-1.76 1.28-1.76c1.09 0 1.1 1.02 1.1 1.82v3.33z'
	}
]
---

<PageLayout meta={{ title: 'About', description: 'Learn more about Markus Becerra.' }}>
	<!-- Page header -->
	<section class='flex flex-col gap-y-3'>
		<span class='text-sm font-medium uppercase tracking-widest text-brand'>About</span>
		<h1 class='font-display text-4xl font-medium tracking-tight sm:text-5xl'>Hey, I'm Markus.</h1>
	</section>

	<!-- Profile: photo + bio ─────────────────────────────────────────────────── -->
	<section class='mt-10'>
		<div class='flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10'>
			<!--
				Photo placeholder.
				To add your photo, replace this entire <div> with:
				<img src="/path/to/photo.jpg" alt="Markus Becerra" class="h-44 w-44 shrink-0 rounded-2xl object-cover" />
				Or use Astro's <Image /> component for automatic optimization.
			-->
			<div
				class='relative h-44 w-44 shrink-0 overflow-hidden rounded-2xl border-2 border-dashed border-border bg-card'
			>
				<div
					class='flex h-full w-full flex-col items-center justify-center gap-y-2 text-muted-foreground'
				>
					<svg
						class='h-12 w-12 opacity-20'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='1.5'
						stroke-linecap='round'
						stroke-linejoin='round'
					>
						<path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'></path>
						<circle cx='12' cy='7' r='4'></circle>
					</svg>
					<span class='text-xs font-medium opacity-30'>Add photo</span>
				</div>
			</div>

			<!-- Bio — replace the placeholder paragraphs with your own words -->
			<div class='flex flex-col gap-y-4'>
				<p class='text-lg leading-relaxed text-muted-foreground'>
					[Your bio goes here. A few sentences about who you are, what you do, and what drives you.
					Keep it personal and genuine.]
				</p>
				<p class='text-muted-foreground'>
					[Add a second paragraph if you'd like — maybe where you're based, your background, or what
					you're currently working on.]
				</p>
				<div class='flex flex-wrap items-center gap-3 pt-1'>
					<a
						href='mailto:markusbecerra@gmail.com'
						class='inline-flex items-center gap-x-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90'
					>
						Get in touch
						<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24'>
							<path
								fill='currentColor'
								d='M5 12h13m0 0l-5-5m5 5l-5 5'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								fill-opacity='0'></path>
						</svg>
					</a>
					<a
						href='/work'
						class='inline-flex items-center rounded-full border border-border px-5 py-2.5 text-sm font-medium transition-colors hover:bg-secondary'
					>
						View my work →
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Hobbies & Interests ─────────────────────────────────────────────────── -->
	<section class='mt-16'>
		<h2 class='mb-5 text-sm font-medium uppercase tracking-widest text-muted-foreground'>
			Hobbies & Interests
		</h2>
		<div class='flex flex-wrap gap-2'>
			{
				hobbies.map((hobby) => (
					<span class='rounded-full border border-border bg-card px-4 py-2 text-sm font-medium shadow-soft'>
						{hobby}
					</span>
				))
			}
		</div>
	</section>

	<!-- Social links ─────────────────────────────────────────────────────────── -->
	<section class='mt-16'>
		<h2 class='mb-5 text-sm font-medium uppercase tracking-widest text-muted-foreground'>
			Find me on
		</h2>
		<div class='grid gap-3 sm:grid-cols-2'>
			{
				socials.map((s) => (
					<a
						href={s.href}
						target='_blank'
						rel='noopener noreferrer'
						class:list={[
							'group flex items-center gap-x-4 rounded-2xl border bg-card p-4 shadow-soft transition-all hover:-translate-y-0.5',
							s.deprecated
								? 'border-border opacity-60 hover:opacity-75'
								: 'border-border hover:border-brand/30'
						]}
					>
						<span class='flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-border bg-background text-muted-foreground transition-colors group-hover:text-brand'>
							<svg class='h-5 w-5' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>
								<path fill='currentColor' d={s.icon} />
							</svg>
						</span>
						<div class='min-w-0 flex-1'>
							<div class='flex items-center gap-x-2'>
								<p class='font-medium'>{s.label}</p>
								{s.deprecated && (
									<span class='rounded-full bg-secondary px-2 py-0.5 text-[10px] font-medium text-muted-foreground'>
										Deprecated
									</span>
								)}
							</div>
							<p class='truncate text-sm text-muted-foreground'>{s.handle}</p>
						</div>
						<svg
							class='h-4 w-4 shrink-0 text-muted-foreground/40 transition-transform group-hover:translate-x-0.5 group-hover:text-brand/70'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'
							stroke-linejoin='round'
						>
							<path d='M5 12h14m0 0l-6-6m6 6l-6 6'></path>
						</svg>
					</a>
				))
			}
		</div>
	</section>

	<!-- Contact ──────────────────────────────────────────────────────────────── -->
	<section class='mt-16'>
		<div class='rounded-2xl border border-border bg-card p-8 shadow-soft'>
			<h2 class='font-display text-2xl font-medium tracking-tight'>Get in touch</h2>
			<p class='mt-2 max-w-md text-muted-foreground'>
				Have a project in mind, want to collaborate, or just want to say hello? My inbox is open.
			</p>
			<div class='mt-6 flex flex-wrap items-center gap-4'>
				<a
					href='mailto:markusbecerra@gmail.com'
					class='inline-flex items-center gap-x-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90'
				>
					Send an email
					<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24'>
						<path
							fill='currentColor'
							d='M5 12h13m0 0l-5-5m5 5l-5 5'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'
							stroke-linejoin='round'
							fill-opacity='0'></path>
					</svg>
				</a>
				<span class='text-sm text-muted-foreground'>markusbecerra@gmail.com</span>
			</div>
		</div>
	</section>
</PageLayout>
