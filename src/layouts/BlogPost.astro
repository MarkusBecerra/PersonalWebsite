---
import type { CollectionEntry } from 'astro:content'

import BlogHero from '@/components/blog/Hero.astro'
import TOC from '@/components/blog/TOC.astro'

import PageLayout from './BaseLayout.astro'

interface Props {
	post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const {
	data: { description, ogImage, pubDate, title, updatedDate },
	slug
} = post

const socialImage = ogImage ?? `/og-image/${slug}.png`
const articleDate = updatedDate?.toISOString() ?? pubDate.toISOString()
const { headings } = await post.render()
---

<PageLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<div class='w-full'>
		<a
			href='/blog'
			class='inline-flex items-center gap-x-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground'
		>
			<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24'>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'></path>
			</svg>
			All posts
		</a>

		<div class='mt-8 gap-x-10 lg:flex lg:items-start'>
			{!!headings.length && <TOC headings={headings} />}
			<article class='min-w-0 flex-grow break-words' data-pagefind-body>
				<div id='blog-hero'><BlogHero content={post} /></div>
				<div
					class='prose prose-zinc mt-10 max-w-none border-t border-border pt-10 dark:prose-invert prose-headings:font-display prose-headings:font-medium prose-headings:text-foreground prose-a:text-brand prose-a:no-underline hover:prose-a:underline'
				>
					<slot />
				</div>
			</article>
		</div>

		<button
			aria-label='Back to top'
			class='fixed bottom-8 end-6 z-40 flex h-11 w-11 translate-y-28 items-center justify-center rounded-full border border-border bg-card text-foreground opacity-0 shadow-soft transition-all duration-300 hover:bg-secondary data-[show=true]:translate-y-0 data-[show=true]:opacity-100'
			data-show='false'
			id='to-top-btn'
		>
			<svg
				aria-hidden='true'
				class='h-4 w-4'
				fill='none'
				stroke='currentColor'
				stroke-width='2'
				viewBox='0 0 24 24'
				xmlns='http://www.w3.org/2000/svg'
			>
				<path d='M4.5 15.75l7.5-7.5 7.5 7.5' stroke-linecap='round' stroke-linejoin='round'></path>
			</svg>
		</button>
	</div>
</PageLayout>

<script>
	const scrollBtn = document.getElementById('to-top-btn') as HTMLButtonElement
	const targetHeader = document.getElementById('blog-hero') as HTMLDivElement

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString()
		})
	}

	scrollBtn.addEventListener('click', () => {
		document.documentElement.scrollTo({ behavior: 'smooth', top: 0 })
	})

	const observer = new IntersectionObserver(callback)
	observer.observe(targetHeader)
</script>
