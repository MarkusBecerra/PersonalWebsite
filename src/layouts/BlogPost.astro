---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import BlogHero from '@/components/blog/Hero.astro'
import TOC from '@/components/blog/TOC.astro'
import { getAllPosts, sortMDByDate } from '@/utils'

import PageLayout from './BaseLayout.astro'

interface Props {
	post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const {
	data: { description, ogImage, pubDate, title, updatedDate },
	id
} = post

const socialImage = ogImage ?? `/og-image/${id}.png`
const articleDate = updatedDate?.toISOString() ?? pubDate.toISOString()
const { headings } = await render(post)

// Neighbours in the same newest-first order the blog index uses, so a reader who
// finishes a post has somewhere to go besides the footer.
const ordered = sortMDByDate(await getAllPosts())
const index = ordered.findIndex((entry) => entry.id === id)
const neighbours = [
	{ label: 'Newer', entry: index > 0 ? ordered[index - 1] : undefined },
	{ label: 'Older', entry: index >= 0 ? ordered[index + 1] : undefined }
].flatMap(({ label, entry }) => (entry ? [{ label, entry }] : []))
---

<PageLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<div class='w-full'>
		<a href='/blog' class='text-sm text-muted-foreground transition-colors hover:text-foreground'>
			← All writing
		</a>

		<div class='mt-8 gap-x-10 lg:flex lg:items-start'>
			<article class='min-w-0 flex-grow break-words' data-pagefind-body>
				<div id='blog-hero'><BlogHero content={post} /></div>
				<div
					class='prose prose-stone mt-10 max-w-none border-t border-border pt-10 text-foreground dark:prose-invert sm:prose-lg prose-headings:font-display prose-headings:font-normal prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground prose-a:text-brand prose-a:decoration-brand/40 prose-a:underline-offset-4 hover:prose-a:decoration-brand prose-strong:text-foreground prose-code:text-foreground prose-code:before:content-none prose-code:after:content-none'
				>
					<slot />
				</div>
			</article>
			{
				/* After the article in source order so the h1 comes first; order-2 keeps it on the right. */
			}
			{!!headings.length && <TOC headings={headings} />}
		</div>

		<nav class='mt-16 border-t border-border' aria-label='More writing'>
			<ul class='divide-y divide-border'>
				{
					neighbours.map(({ label, entry }) => (
						<li>
							<a
								href={`/blog/${entry.id}/`}
								class='group grid gap-y-1 py-4 sm:grid-cols-[9rem_1fr] sm:items-baseline sm:gap-x-6'
							>
								<span class='font-display italic text-muted-foreground'>{label}</span>
								<span class='font-display text-xl leading-snug tracking-tight transition-colors group-hover:text-brand'>
									{entry.data.title}
								</span>
							</a>
						</li>
					))
				}
				<li class='py-4'>
					<a href='/blog' class='link text-sm'>All writing</a>
				</li>
			</ul>
		</nav>

		<button
			aria-label='Back to top'
			class='invisible fixed bottom-8 end-6 z-40 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border border-border bg-background text-muted-foreground opacity-0 transition-all duration-300 hover:text-foreground data-[show=true]:visible data-[show=true]:translate-y-0 data-[show=true]:opacity-100'
			data-show='false'
			id='to-top-btn'
		>
			<svg
				aria-hidden='true'
				class='h-4 w-4'
				fill='none'
				stroke='currentColor'
				stroke-width='2'
				viewBox='0 0 24 24'
				xmlns='http://www.w3.org/2000/svg'
			>
				<path d='M4.5 15.75l7.5-7.5 7.5 7.5' stroke-linecap='round' stroke-linejoin='round'></path>
			</svg>
		</button>
	</div>
</PageLayout>

<script>
	const scrollBtn = document.getElementById('to-top-btn') as HTMLButtonElement
	const targetHeader = document.getElementById('blog-hero') as HTMLDivElement

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString()
		})
	}

	scrollBtn.addEventListener('click', () => {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
		document.documentElement.scrollTo({ behavior: reduceMotion ? 'auto' : 'smooth', top: 0 })
	})

	const observer = new IntersectionObserver(callback)
	observer.observe(targetHeader)
</script>
