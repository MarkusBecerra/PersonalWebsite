---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import BlogHero from '@/components/blog/Hero.astro'
import TOC from '@/components/blog/TOC.astro'

import PageLayout from './BaseLayout.astro'

interface Props {
	post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const {
	data: { description, ogImage, pubDate, title, updatedDate },
	id
} = post

const socialImage = ogImage ?? `/og-image/${id}.png`
const articleDate = updatedDate?.toISOString() ?? pubDate.toISOString()
const { headings } = await render(post)
---

<PageLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<div class='w-full'>
		<a href='/blog' class='text-sm text-muted-foreground transition-colors hover:text-foreground'>
			← All writing
		</a>

		<div class='mt-8 gap-x-10 lg:flex lg:items-start'>
			{!!headings.length && <TOC headings={headings} />}
			<article class='min-w-0 flex-grow break-words' data-pagefind-body>
				<div id='blog-hero'><BlogHero content={post} /></div>
				<div
					class='prose prose-stone mt-10 max-w-none border-t border-border pt-10 text-foreground dark:prose-invert sm:prose-lg prose-headings:font-display prose-headings:font-normal prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground/90 prose-a:text-brand prose-a:decoration-brand/40 prose-a:underline-offset-4 hover:prose-a:decoration-brand prose-strong:text-foreground prose-code:text-foreground prose-code:before:content-none prose-code:after:content-none'
				>
					<slot />
				</div>
			</article>
		</div>

		<button
			aria-label='Back to top'
			class='fixed bottom-8 end-6 z-40 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border border-border bg-background text-muted-foreground opacity-0 transition-all duration-300 hover:text-foreground data-[show=true]:translate-y-0 data-[show=true]:opacity-100'
			data-show='false'
			id='to-top-btn'
		>
			<svg
				aria-hidden='true'
				class='h-4 w-4'
				fill='none'
				stroke='currentColor'
				stroke-width='2'
				viewBox='0 0 24 24'
				xmlns='http://www.w3.org/2000/svg'
			>
				<path d='M4.5 15.75l7.5-7.5 7.5 7.5' stroke-linecap='round' stroke-linejoin='round'></path>
			</svg>
		</button>
	</div>
</PageLayout>

<script>
	const scrollBtn = document.getElementById('to-top-btn') as HTMLButtonElement
	const targetHeader = document.getElementById('blog-hero') as HTMLDivElement

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString()
		})
	}

	scrollBtn.addEventListener('click', () => {
		document.documentElement.scrollTo({ behavior: 'smooth', top: 0 })
	})

	const observer = new IntersectionObserver(callback)
	observer.observe(targetHeader)
</script>
