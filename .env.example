# Temporary "under construction" gate — see the Site lock section in README.md.
# Both are read at build time, so changing either one needs a redeploy.

# Set to false to take the site public again.
SITE_LOCKED=true

# The shared password. Defaults to `goldenhour` when unset, which is visible in
# this public repo — set a real value in the Vercel project.
# SITE_PASSWORD=
